<VSTemplateManifest Version="1.0" xmlns="http://schemas.microsoft.com/developer/vstemplatemanifest/2015">
  <VSTemplateContainer TemplateType="Project">
    <RelativePathOnDisk>VisualBasic\VbcConsoleApp</RelativePathOnDisk>
    <TemplateFileName>MyTemplate.vstemplate</TemplateFileName>
    <VSTemplateHeader>
      <TemplateData xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
        <TemplateID>Vbc.NativeApplication</TemplateID>
        <Name>VBC Native Application</Name>
        <Description>Creates an ultra-fast native Visual Basic C (VBC) application with zero GC and linear arena data stack.</Description>
        <ProjectType>VisualBasic</ProjectType>
        <SortOrder>10</SortOrder>
        <CreateNewFolder>true</CreateNewFolder>
        <DefaultName>VbcApp</DefaultName>
        <ProvideDefaultName>true</ProvideDefaultName>
        <LocationField>Enabled</LocationField>
        <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
        <NumberOfParentCategoriesToRollUp>2</NumberOfParentCategoriesToRollUp>
        <LanguageTag>VisualBasic</LanguageTag>
        <LanguageTag>visualbasic</LanguageTag>
        <PlatformTag>Windows</PlatformTag>
        <PlatformTag>windows</PlatformTag>
        <ProjectTypeTag>Console</ProjectTypeTag>
        <ProjectTypeTag>console</ProjectTypeTag>
      </TemplateData>
    </VSTemplateHeader>
  </VSTemplateContainer>
