{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "VBC",
  "scopeName": "source.vbc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.vbc",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.vbc",
          "match": "(?i)\\bRem\\b.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vbc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vbc",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.vbc",
          "match": "(?i)&H[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.vbc",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.vbc",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vbc",
          "match": "(?i)\\b(If|Then|ElseIf|Else|End\\s+If|For|Each|In|To|Step|Next|While|End\\s+While|Do|Loop|Select|Case|End\\s+Select|Try|Catch|Finally|End\\s+Try|Throw|Return)\\b"
        },
        {
          "name": "keyword.declaration.vbc",
          "match": "(?i)\\b(Module|End\\s+Module|Structure|End\\s+Structure|Class|End\\s+Class|Sub|End\\s+Sub|Function|End\\s+Function|Dim|Const|Imports|Include|As)\\b"
        },
        {
          "name": "keyword.operator.vbc",
          "match": "(?i)\\b(And|Or|Not|AddressOf|New|ByVal|ByRef)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.vbc",
          "match": "(?i)\\b(Integer|Long|Short|Byte|Single|Double|Boolean|String|Object|Void|Pointer|IntPtr|UIntPtr|Exception|HttpClient|HttpServer|HttpRequest|HttpResponse)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.vbc",
          "match": "(?i)\\b(True|False|Nothing)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "(?i)\\b(Sub|Function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.vbc" },
            "2": { "name": "entity.name.function.vbc" }
          }
        },
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.vbc"
        }
      ]
    }
  }
}
