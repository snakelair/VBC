        If kind = TOK_EXIT Then Return "TOK_EXIT"
        If kind = TOK_CONTINUE Then Return "TOK_CONTINUE"
        If kind = TOK_FROM Then Return "TOK_FROM"
        If kind = TOK_WHERE Then Return "TOK_WHERE"
        If kind = TOK_SELECT Then Return "TOK_SELECT"
        If kind = TOK_AGGREGATE Then Return "TOK_AGGREGATE"
        If kind = TOK_INTO Then Return "TOK_INTO"
        If kind = TOK_DISTINCT Then Return "TOK_DISTINCT"
        If kind = TOK_TAKE Then Return "TOK_TAKE"
        If kind = TOK_SKIP Then Return "TOK_SKIP"
        If kind = TOK_BYVAL Then Return "TOK_BYVAL"
        If kind = TOK_BYREF Then Return "TOK_BYREF"
        If kind = TOK_NEW Then Return "TOK_NEW"
        If kind = TOK_TRUE Then Return "TOK_TRUE"
        If kind = TOK_FALSE Then Return "TOK_FALSE"
        If kind = TOK_NOTHING Then Return "TOK_NOTHING"
        If kind = TOK_CLASS Then Return "TOK_CLASS"
        If kind = TOK_INHERITS Then Return "TOK_INHERITS"
        If kind = TOK_OVERRIDABLE Then Return "TOK_OVERRIDABLE"
        If kind = TOK_OVERRIDES Then Return "TOK_OVERRIDES"
        If kind = TOK_MYBASE Then Return "TOK_MYBASE"
        If kind = TOK_ME Then Return "TOK_ME"
        If kind = TOK_PUBLIC Then Return "TOK_PUBLIC"
        If kind = TOK_PRIVATE Then Return "TOK_PRIVATE"
        If kind = TOK_PROTECTED Then Return "TOK_PROTECTED"
        If kind = TOK_USING Then Return "TOK_USING"
        If kind = TOK_NAMESPACE Then Return "TOK_NAMESPACE"
        If kind = TOK_TRY Then Return "TOK_TRY"
        If kind = TOK_CATCH Then Return "TOK_CATCH"
        If kind = TOK_FINALLY Then Return "TOK_FINALLY"
        If kind = TOK_THROW Then Return "TOK_THROW"
        If kind = TOK_SYNCLOCK Then Return "TOK_SYNCLOCK"
        If kind = TOK_BYTE Then Return "TOK_BYTE"
        If kind = TOK_INTERFACE Then Return "TOK_INTERFACE"
        If kind = TOK_IMPLEMENTS Then Return "TOK_IMPLEMENTS"
        If kind = TOK_QUESTION Then Return "TOK_QUESTION"
        If kind = TOK_QDOT Then Return "TOK_QDOT"
        If kind = TOK_QLPAREN Then Return "TOK_QLPAREN"
        If kind = TOK_XML_CHILD Then Return "TOK_XML_CHILD"
        If kind = TOK_XML_ATTR Then Return "TOK_XML_ATTR"
        If kind = TOK_XML_DESC Then Return "TOK_XML_DESC"
        If kind = TOK_LPAREN Then Return "TOK_LPAREN"
        If kind = TOK_RPAREN Then Return "TOK_RPAREN"
        If kind = TOK_LBRACKET Then Return "TOK_LBRACKET"
        If kind = TOK_RBRACKET Then Return "TOK_RBRACKET"
        If kind = TOK_COMMA Then Return "TOK_COMMA"
        If kind = TOK_DOT Then Return "TOK_DOT"
        If kind = TOK_COLON Then Return "TOK_COLON"
        If kind = TOK_NEWLINE Then Return "TOK_NEWLINE"
        If kind = TOK_EQUAL Then Return "TOK_EQUAL"
        If kind = TOK_NOTEQUAL Then Return "TOK_NOTEQUAL"
        If kind = TOK_LESS Then Return "TOK_LESS"
        If kind = TOK_LESSEQ Then Return "TOK_LESSEQ"
        If kind = TOK_GREATER Then Return "TOK_GREATER"
        If kind = TOK_GREATEREQ Then Return "TOK_GREATEREQ"
        If kind = TOK_PLUS Then Return "TOK_PLUS"
        If kind = TOK_MINUS Then Return "TOK_MINUS"
        If kind = TOK_STAR Then Return "TOK_STAR"
        If kind = TOK_SLASH Then Return "TOK_SLASH"
        If kind = TOK_AMP Then Return "TOK_AMP"
        If kind = TOK_MOD Then Return "TOK_MOD"
        If kind = TOK_AND Then Return "TOK_AND"
        If kind = TOK_OR Then Return "TOK_OR"
        If kind = TOK_NOT Then Return "TOK_NOT"
        If kind = TOK_ANDALSO Then Return "TOK_ANDALSO"
        If kind = TOK_ORELSE Then Return "TOK_ORELSE"
        If kind = TOK_XOR Then Return "TOK_XOR"
        If kind = TOK_SHL Then Return "TOK_SHL"
        If kind = TOK_SHR Then Return "TOK_SHR"
        Return "TOK_UNKNOWN"
    End Function
End Module
