Imports System

Module EmitterModule
    Function EmitCompilationUnitToC(unitId As Integer) As String
        EmitInit()
        globalSliceVars = []
        Dim modChild0 = Nodes(unitId).FirstChild
        While modChild0 <> -1
            If Nodes(modChild0).Kind = NODE_MODULE Then
                Dim mc = Nodes(modChild0).FirstChild
                While mc <> -1
                    If Nodes(mc).Kind = NODE_VARDECL Then
                        Dim g As LocalVarInfo
                        g.Name = Nodes(mc).Name
                        g.TypeName = Nodes(mc).TypeName
                        g.IsByRef = False
                        globalSliceVars.Add(g)
                    End If
                    mc = Nodes(mc).NextSibling
                End While
            End If
            modChild0 = Nodes(modChild0).NextSibling
        End While

        EmitWriteLine("// Auto-generated by Self-Hosted VBC (vbc-stage2)")
        EmitWriteLine("#include ""vbc_runtime.h""")
        EmitWriteLine("#include ""vbc_socket.h""")
        EmitWriteLine("#include ""vbc_http.h""")
        EmitWriteLine("#include ""vbc_crypto.h""")
        EmitWriteLine("#include ""vbc_gzip.h""")
        EmitWriteLine("#include ""vbc_image.h""")
        EmitWriteLine("#include ""vbc_fs.h""")
        EmitWriteLine("#include ""vbc_bcl.h""")
        EmitWriteLine("#include ""vbc_xml.h""")
        EmitWriteLine("")

        ' 1. Forward declare all structures, classes, and interfaces
        For i = 0 To Nodes.Length - 1
            If Nodes(i).Kind = NODE_STRUCTURE Then
                EmitWriteLine("typedef struct Vbc_" & MangleName(Nodes(i).Name) & " Vbc_" & MangleName(Nodes(i).Name) & ";")
            ElseIf Nodes(i).Kind = NODE_CLASS Then
                EmitWriteLine("typedef struct Vbc_" & MangleName(Nodes(i).Name) & " Vbc_" & MangleName(Nodes(i).Name) & ";")
                If ClassHasVirtualMethods(i) And GetRootClassNode(i) = i Then
                    EmitWriteLine("typedef struct Vbc_" & MangleName(Nodes(i).Name) & "_VTable Vbc_" & MangleName(Nodes(i).Name) & "_VTable;")
                End If
            ElseIf Nodes(i).Kind = NODE_INTERFACE Then
                EmitWriteLine("typedef struct Vbc_" & MangleName(Nodes(i).Name) & " Vbc_" & MangleName(Nodes(i).Name) & ";")
                EmitWriteLine("typedef struct Vbc_" & MangleName(Nodes(i).Name) & "_VTable Vbc_" & MangleName(Nodes(i).Name) & "_VTable;")
            End If
        Next
        EmitWriteLine("")

        ' 2. VTable struct definitions
        For i = 0 To Nodes.Length - 1
            If Nodes(i).Kind = NODE_CLASS And ClassHasVirtualMethods(i) And GetRootClassNode(i) = i Then
                EmitVTableDefinition(i)
            End If
        Next

        ' 2b. Interface definitions (VTable and Fat Pointer struct)
        For i = 0 To Nodes.Length - 1
            If Nodes(i).Kind = NODE_INTERFACE Then
                EmitInterfaceDefinition(i)
            End If
        Next

        ' 3. Forward declare methods of structures and classes
        For i = 0 To Nodes.Length - 1
            If Nodes(i).Kind = NODE_STRUCTURE Then
                Dim ch = Nodes(i).FirstChild
                While ch <> -1
                    If Nodes(ch).Kind = NODE_FUNCTION Or Nodes(ch).Kind = NODE_SUB Then
                        EmitTypeMethodPrototype(i, ch, False)
                    End If
                    ch = Nodes(ch).NextSibling
                End While
            ElseIf Nodes(i).Kind = NODE_CLASS Then
                Dim ch = Nodes(i).FirstChild
                Dim hasExplicitCtor = False
                While ch <> -1
                    If Nodes(ch).Kind = NODE_FUNCTION Or Nodes(ch).Kind = NODE_SUB Then
                        EmitTypeMethodPrototype(i, ch, True)
                        If CaseInsensitiveEquals(Nodes(ch).Name, "New") Then hasExplicitCtor = True
                    End If
                    ch = Nodes(ch).NextSibling
                End While
                If Not hasExplicitCtor Then
                    EmitWriteLine("Vbc_" & MangleName(Nodes(i).Name) & "* Vbc_" & MangleName(Nodes(i).Name) & "_New(vbc_stack_t* _stack);")
                End If
            End If
        Next
        EmitWriteLine("")

        ' 4. Forward declare module functions
        Dim topItem = Nodes(unitId).FirstChild
        While topItem <> -1
            If Nodes(topItem).Kind = NODE_MODULE Then
                Dim mc = Nodes(topItem).FirstChild
                While mc <> -1
                    If Nodes(mc).Kind = NODE_FUNCTION Or Nodes(mc).Kind = NODE_SUB Then
                        EmitFunctionPrototype(mc)
                    End If
                    mc = Nodes(mc).NextSibling
                End While
            ElseIf Nodes(topItem).Kind = NODE_FUNCTION Or Nodes(topItem).Kind = NODE_SUB Then
                EmitFunctionPrototype(topItem)
            End If
            topItem = Nodes(topItem).NextSibling
        End While
        EmitWriteLine("")

        ' 5. Static VTables
        For i = 0 To Nodes.Length - 1
            If Nodes(i).Kind = NODE_CLASS And ClassHasVirtualMethods(i) Then
                EmitStaticVTable(i)
            End If
        Next

        ' 5b. Static Interface VTables for Classes
        For i = 0 To Nodes.Length - 1
            If Nodes(i).Kind = NODE_CLASS And Nodes(i).StringValue.Length > 0 Then
                Dim impls As String = Nodes(i).StringValue
                Dim curr As String = ""
                For si = 0 To impls.Length - 1
                    Dim cChar As String = impls.Substring(si, 1)
                    If cChar = "," Then
                        Dim ifNode = FindInterfaceNode(curr)
                        If ifNode >= 0 Then EmitClassInterfaceVTable(i, ifNode)
                        curr = ""
                    Else
                        curr = curr & cChar
                    End If
                Next
                If curr.Length > 0 Then
                    Dim ifNode = FindInterfaceNode(curr)
                    If ifNode >= 0 Then EmitClassInterfaceVTable(i, ifNode)
                End If
            End If
        Next

        ' 6. Emit Structure definitions
        For i = 0 To Nodes.Length - 1
            If Nodes(i).Kind = NODE_STRUCTURE Then
                EmitStructure(i)
            End If
        Next

        ' 7. Emit Class definitions (base classes first)
        Dim emittedClasses() As Integer = []
        Dim totalClasses = 0
        For i = 0 To Nodes.Length - 1
            If Nodes(i).Kind = NODE_CLASS Then totalClasses = totalClasses + 1
        Next

        While emittedClasses.Length < totalClasses
            Dim progress = False
            For i = 0 To Nodes.Length - 1
                If Nodes(i).Kind = NODE_CLASS Then
                    Dim alreadyEmitted = False
                    For ei = 0 To emittedClasses.Length - 1
                        If emittedClasses(ei) = i Then alreadyEmitted = True
                    Next
                    If Not alreadyEmitted Then
                        Dim baseClass = Nodes(i).TypeName
                        Dim baseEmitted = True
                        If baseClass.Length > 0 Then
                            baseEmitted = False
                            For ei = 0 To emittedClasses.Length - 1
                                If CaseInsensitiveEquals(Nodes(emittedClasses(ei)).Name, baseClass) Then
                                    baseEmitted = True
                                End If
                            Next
                        End If
                        If baseEmitted Then
                            EmitClassDefinition(i)
                            emittedClasses.Add(i)
                            progress = True
                        End If
                    End If
                End If
            Next
            If Not progress Then Exit While
        End While

        ' 8. Emit Structure methods & constructors
        For i = 0 To Nodes.Length - 1
            If Nodes(i).Kind = NODE_STRUCTURE Then
                Dim ch = Nodes(i).FirstChild
                While ch <> -1
                    If Nodes(ch).Kind = NODE_FUNCTION Or Nodes(ch).Kind = NODE_SUB Then
                        EmitTypeMethod(i, ch, False)
                    End If
                    ch = Nodes(ch).NextSibling
                End While
            End If
        Next

        ' 9. Emit Class methods, constructors, and New factories
        For i = 0 To Nodes.Length - 1
            If Nodes(i).Kind = NODE_CLASS Then
                Dim ch = Nodes(i).FirstChild
                Dim hasExplicitCtor = False
                While ch <> -1
                    If Nodes(ch).Kind = NODE_FUNCTION Or Nodes(ch).Kind = NODE_SUB Then
                        EmitTypeMethod(i, ch, True)
                        If CaseInsensitiveEquals(Nodes(ch).Name, "New") Then hasExplicitCtor = True
                    End If
                    ch = Nodes(ch).NextSibling
                End While
                If Not hasExplicitCtor Then
                    Dim cName = MangleName(Nodes(i).Name)
                    Dim root = GetRootClassNode(i)
                    Dim hasVirt = ClassHasVirtualMethods(i)
                    EmitWriteLine("Vbc_" & cName & "* Vbc_" & cName & "_New(vbc_stack_t* _stack) {")
                    EmitWriteLine("    Vbc_" & cName & "* Me = (Vbc_" & cName & "*)vbc_stack_alloc(_stack, sizeof(Vbc_" & cName & "), sizeof(void*));")
                    EmitWriteLine("    memset(Me, 0, sizeof(Vbc_" & cName & "));")
                    If hasVirt Then
                        EmitWriteLine("    ((Vbc_" & MangleName(Nodes(root).Name) & "*)Me)->_vtable = &_vbc_" & cName & "_vtable;")
                    End If
                    EmitWriteLine("    return Me;")
                    EmitWriteLine("}")
                    EmitWriteLine("")
                End If
            End If
        Next

        ' 10. Emit Module Global Variables
        For i = 0 To Nodes.Length - 1
            If Nodes(i).Kind = NODE_MODULE Then
                Dim mc = Nodes(i).FirstChild
                While mc <> -1
                    If Nodes(mc).Kind = NODE_VARDECL Then
                        Dim cType = MapCType(Nodes(mc).TypeName)
                        If Nodes(mc).FirstChild >= 0 Then
                            Dim initStr = EmitExpr(Nodes(mc).FirstChild)
                            EmitWriteLine("static " & cType & " " & Nodes(mc).Name & " = " & initStr & ";")
                        Else
                            EmitWriteLine("static " & cType & " " & Nodes(mc).Name & " = {0};")
                        End If
                    End If
                    mc = Nodes(mc).NextSibling
                End While
            End If
        Next
        EmitWriteLine("")

        ' 11. Emit Module Function definitions
        Dim hasMain = False
        Dim mainHasParams = False
        Dim topFunc = Nodes(unitId).FirstChild
        While topFunc <> -1
            If Nodes(topFunc).Kind = NODE_MODULE Then
                Dim mc = Nodes(topFunc).FirstChild
                While mc <> -1
                    If Nodes(mc).Kind = NODE_FUNCTION Or Nodes(mc).Kind = NODE_SUB Then
                        If CaseInsensitiveEquals(Nodes(mc).Name, "main") Then
                            hasMain = True
                            If Nodes(mc).ChildCount > 0 And Nodes(Nodes(mc).FirstChild).Kind = NODE_PARAM Then
                                mainHasParams = True
                            End If
                        End If
                        EmitFunction(mc)
                    End If
                    mc = Nodes(mc).NextSibling
                End While
            ElseIf Nodes(topFunc).Kind = NODE_FUNCTION Or Nodes(topFunc).Kind = NODE_SUB Then
                If CaseInsensitiveEquals(Nodes(topFunc).Name, "main") Then
                    hasMain = True
                    If Nodes(topFunc).ChildCount > 0 And Nodes(Nodes(topFunc).FirstChild).Kind = NODE_PARAM Then
                        mainHasParams = True
                    End If
                End If
                EmitFunction(topFunc)
            End If
            topFunc = Nodes(topFunc).NextSibling
        End While

        ' Emit Native C main() entrypoint
        EmitWriteLine("/* ========================================================================= */")
        EmitWriteLine("/* Native Entrypoint                                                         */")
        EmitWriteLine("/* ========================================================================= */")
        EmitWriteLine("int main(int argc, char** argv) {")
        EmitWriteLine("    vbc_socket_system_init();")
        EmitWriteLine("    vbc_stack_t _main_stack;")
        EmitWriteLine("    vbc_stack_init(&_main_stack, (size_t)8192 * 1024 * 1024);")
        EmitWriteLine("")
        If hasMain Then
            If mainHasParams Then
                EmitWriteLine("    vbc_slice_t _args = vbc_slice_create(&_main_stack, argc > 0 ? argc : 1, sizeof(vbc_string_t));")
                EmitWriteLine("    for (int _ai = 0; _ai < argc; _ai++) {")
                EmitWriteLine("        vbc_string_t _as = vbc_str_lit(argv[_ai]);")
                EmitWriteLine("        vbc_slice_push(&_main_stack, &_args, &_as);")
                EmitWriteLine("    }")
                EmitWriteLine("    Vbc_Main(&_main_stack, _args);")
            Else
                EmitWriteLine("    (void)argc; (void)argv;")
                EmitWriteLine("    Vbc_Main(&_main_stack);")
            End If
        Else
            EmitWriteLine("    (void)argc; (void)argv;")
        End If
        EmitWriteLine("")
        EmitWriteLine("    vbc_stack_free(&_main_stack);")
        EmitWriteLine("    vbc_socket_system_cleanup();")
        EmitWriteLine("    return 0;")
        EmitWriteLine("}")

        Return outBuf
    End Function

End Module
