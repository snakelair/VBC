Imports System

Module StressModule
    Function Compute_0(a As Integer, b As Integer, c As Integer) As Integer
        Dim r1 = a * 1 + b * 1 - c
        Dim r2 = (r1 * 3) / 2 + (a Mod 7)
        If r2 > 100 Then
            r2 = r2 - 50
        Else
            r2 = r2 + 25
        End If
        Dim sum = 0
        For j = 0 To 2
            sum = sum + j * r2
        Next
        Return sum + r1
    End Function
