Structure Point3D
    Dim X As Double
    Dim Y As Double
    Dim Z As Double
End Structure

Module Program
    Sub Main()
        Dim n As Integer = 1000000
        Dim pts(1000000) As Point3D
        For i As Integer = 0 To n - 1
            pts(i).X = i * 1.0
            pts(i).Y = i * 2.0
            pts(i).Z = i * 3.0
        Next
        Dim sum As Double = 0.0
        For i As Integer = 0 To n - 1
            sum = sum + pts(i).X + pts(i).Y + pts(i).Z
        Next
        Console.WriteLine(sum)
    End Sub
End Module
